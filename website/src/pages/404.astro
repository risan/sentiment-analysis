---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Sentiment Analysis for PHP" description="This page does not exist." noindex>
  <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
    <h1 class="text-[28px] leading-tight font-semibold">404</h1>
    <p class="mt-2 text-zinc-700">
      This page scored 0.0000 because it does not exist. Check the address, or <a href="/" class="text-blue-700 hover:underline">head back to the homepage</a>.
    </p>
  </main>
</Base>
