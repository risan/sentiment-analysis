---
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import Sidebar from '../components/Sidebar.astro';
import { navOrder, repoUrl, siteName } from '../lib/nav';
import Base from './Base.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  filePath: string;
  headings: MarkdownHeading[];
}

const { slug, title, description, filePath, headings } = Astro.props;

const entries = await getCollection('docs');
const titles = Object.fromEntries(entries.map((entry) => [entry.id, entry.data.title]));

const position = navOrder.indexOf(slug);
const previous = position > 0 ? navOrder[position - 1] : undefined;
const next = position < navOrder.length - 1 ? navOrder[position + 1] : undefined;

const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const editUrl = `${repoUrl}/edit/main/website/${filePath}`;
---

<Base title={`${title} · ${siteName}`} description={description}>
  <div
    class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-6 lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[13rem_minmax(0,1fr)_12rem]"
  >
    <aside class="sticky top-11 hidden max-h-[calc(100vh-2.75rem)] self-start overflow-y-auto py-6 lg:block">
      <Sidebar current={slug} titles={titles} />
    </aside>

    <main id="main-content" tabindex="-1" class="min-w-0 max-w-3xl py-6 outline-none">
      <details class="mb-5 border border-stone-200 text-sm lg:hidden">
        <summary class="cursor-pointer px-3 py-1.5 font-medium">Menu</summary>
        <div class="border-t border-stone-200 px-3 py-3">
          <Sidebar current={slug} titles={titles} />
        </div>
      </details>

      <h1 class="mb-4 text-2xl leading-tight font-semibold">{title}</h1>

      <article class="docs prose prose-sm max-w-none">
        <slot />
      </article>

      <div class="mt-10 flex items-baseline justify-between gap-4 border-t border-stone-200 pt-4 text-sm">
        {
          previous ? (
            <a href={`/${previous}/`} class="text-blue-700 hover:underline">
              ← {titles[previous]}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/${next}/`} class="text-right text-blue-700 hover:underline">
              {titles[next]} →
            </a>
          )
        }
      </div>
      <p class="mt-3 text-[13px] text-stone-500">
        <a href={editUrl} class="hover:text-stone-900 hover:underline">Edit this page on GitHub</a>
      </p>
    </main>

    {
      tocHeadings.length >= 2 && (
        <aside class="sticky top-11 hidden max-h-[calc(100vh-2.75rem)] self-start overflow-y-auto py-6 xl:block">
          <p class="mb-1 text-xs font-medium uppercase tracking-wide text-stone-500">On this page</p>
          <ul class="text-[13px]">
            {tocHeadings.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class:list={[
                    'block py-0.5 text-stone-600 hover:text-stone-900',
                    heading.depth === 3 ? 'pl-3' : '',
                  ]}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>
