---
import '../styles/global.css';
import { repoUrl, siteName } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  wide?: boolean;
}

const { title, description, noindex = false, wide = false } = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/og.png', Astro.site).href;
const imageAlt = `${siteName}: English and Indonesian sentiment scoring.`;
const container = `mx-auto w-full px-4 sm:px-6 ${wide ? 'max-w-7xl' : 'max-w-5xl'}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Risan Bagja Pradana" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-[15px] leading-[1.6] text-zinc-900 antialiased">
    <header class="sticky top-0 z-10 border-b border-zinc-200 bg-white">
      <div class:list={[container, 'flex h-11 items-center justify-between']}>
        <a href="/" class="font-mono text-sm font-medium">sentiment-analysis</a>
        <nav class="flex gap-4 text-sm text-zinc-600">
          <a href="/getting-started/introduction/" class="hover:text-zinc-900">Docs</a>
          <a href="/reference/sentiment/" class="hover:text-zinc-900">API</a>
          <a href={repoUrl} class="hover:text-zinc-900">GitHub</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="border-t border-zinc-200 py-4 text-[13px] text-zinc-500">
      <p class:list={[container, 'flex flex-wrap gap-x-2']}>
        <span>MIT License</span>
        <span>·</span>
        <a href={repoUrl} class="hover:text-zinc-900 hover:underline">GitHub</a>
        <span>·</span>
        <a href="https://packagist.org/packages/risan/sentiment-analysis" class="hover:text-zinc-900 hover:underline">Packagist</a>
        <span>·</span>
        <span>by Risan Bagja Pradana</span>
      </p>
    </footer>
  </body>
</html>
