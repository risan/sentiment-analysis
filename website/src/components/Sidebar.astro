---
import { navGroups } from '../lib/nav';

interface Props {
  current: string;
  titles: Record<string, string>;
}

const { current, titles } = Astro.props;
---

<nav aria-label="Documentation" class="space-y-4 text-sm">
  {
    navGroups.map((group) => (
      <div>
        {group.label && <p class="mb-1 text-xs font-medium uppercase tracking-wide text-stone-500">{group.label}</p>}
        <ul>
          {group.slugs.map((slug) => (
            <li>
              <a
                href={`/${slug}/`}
                aria-current={slug === current ? 'page' : undefined}
                class:list={[
                  'block border-l-2 py-0.5 pl-3',
                  slug === current
                    ? 'border-stone-900 font-semibold text-stone-900'
                    : 'border-transparent text-stone-600 hover:text-stone-900',
                ]}
              >
                {titles[slug]}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
