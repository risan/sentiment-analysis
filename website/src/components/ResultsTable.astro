---
import { examplesFor } from '../lib/data';

interface Props {
  language?: 'en' | 'id';
  compact?: boolean;
}

const { language, compact = false } = Astro.props;
const rows = examplesFor(language);
const languageNames = { en: 'English', id: 'Indonesian' };
---

<div class="results-wrap">
  <table class="results">
    <thead>
      <tr>
        <th scope="col">Text</th>
        <th scope="col">Label</th>
        <th scope="col" class="num">Compound</th>
        {
          !compact && (
            <>
              <th scope="col" class="num">Pos</th>
              <th scope="col" class="num">Neu</th>
              <th scope="col" class="num">Neg</th>
            </>
          )
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td lang={row.language}>
              {row.text}
              {!language && <span class="lang">{languageNames[row.language]}</span>}
            </td>
            <td class={`label-${row.label}`}>{row.label}</td>
            <td class="num">{row.compound.toFixed(4)}</td>
            {
              !compact && (
                <>
                  <td class="num">{row.positive.toFixed(3)}</td>
                  <td class="num">{row.neutral.toFixed(3)}</td>
                  <td class="num">{row.negative.toFixed(3)}</td>
                </>
              )
            }
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
