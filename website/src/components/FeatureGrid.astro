---
import { formatNumber, metrics } from '../lib/data';

const speed = metrics.benchmark.shortTextsPerSecond;

const features = [
  {
    icon: '🌏',
    title: 'English and Indonesian',
    body: 'One API, two languages. English runs the VADER rules; Indonesian has its own lexicon and rules for negation, intensifiers and informal spelling.',
  },
  {
    icon: '🧠',
    title: 'Reads like a person',
    body: 'Understands "not good", "very good", "GOOD!!!", "good, but…", emoticons and emoji, not just a bag of words.',
  },
  {
    icon: '📦',
    title: 'Zero dependencies',
    body: 'Pure PHP 8.3+ with ext-mbstring. No API keys, no network calls, no model files, nothing to train.',
  },
  {
    icon: '⚡',
    title: 'Fast and light',
    body:
      speed === null
        ? 'A single pass over the tokens. Lexicons are plain PHP arrays that OPcache keeps in shared memory.'
        : `About ${formatNumber(speed)} short texts per second. Lexicons are plain PHP arrays that OPcache keeps in shared memory.`,
  },
  {
    icon: '🎛️',
    title: 'Yours to tune',
    body: 'Add or override words, drop words, move the neutral threshold. Every analyzer is immutable, so one tweak never leaks into another.',
  },
  {
    icon: '🔓',
    title: 'MIT licensed',
    body: 'Built on the published VADER algorithm, checked against the reference implementation. The Indonesian lexicon is written for this project.',
  },
];
---

<ul class="features">
  {
    features.map((feature) => (
      <li>
        <span class="icon" aria-hidden="true">
          {feature.icon}
        </span>
        <h3>{feature.title}</h3>
        <p>{feature.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  }

  .features li {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 1rem;
    background: var(--sl-color-bg-nav);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .features li:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border-radius: 0.75rem;
    font-size: 1.25rem;
    background: var(--sl-color-accent-low);
  }

  h3 {
    margin: 0 0 0.4rem;
    font-family: 'Bricolage Grotesque Variable', var(--__sl-font);
    font-size: var(--sl-text-xl);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  p {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
